# R-tree index after a server restart: the index is loaded from its stored
# metadata and returns the same rows as before.
#
# Needs a server where opening a table with an index that has no mapping
# B-tree (HAS_ROW_REF only, as this one) from the data dictionary does not
# assert in Custom_index::load_storage().

--let $veb_dest = `SELECT CONCAT(@@veb_dir, '/vsql_cube.veb')`
if ($VSQL_CUBE_VEB) {
  --error 0,1
  --remove_file $veb_dest
  --copy_file $VSQL_CUBE_VEB $veb_dest
}

# Only a build with the R-tree uses preview capabilities, so only such a build
# fails to install while preview extensions are off (error 3219).
--disable_query_log
# The probe's failed INSTALL is logged as an error.
call mtr.add_suppression("Failed to load VEF extension 'vsql_cube': extension requires preview capabilities");
--error 0,3219
INSTALL EXTENSION vsql_cube;
if (!$mysql_errno) {
  UNINSTALL EXTENSION vsql_cube;
  --skip Needs vsql_cube built with -DVSQL_CUBE_RTREE=ON
}
--enable_query_log

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_cube;

CREATE TABLE t (id INT PRIMARY KEY, c `cube`(2) NOT NULL);
CREATE INDEX idx_c ON t (c) USING EXTENDED(vsql_cube.rtree);
INSERT INTO t VALUES
  (1, '(0,0)'),
  (2, '(3,4)'),
  (3, '(1,1),(2,2)'),
  (4, '(10,0)'),
  (5, '(-6,-8)'),
  (6, '(0,7),(1,9)');

--echo # Expected: 1, 3, 2
SELECT id FROM t ORDER BY cube_distance(c, '(0,0)') LIMIT 3;

--echo # A table that is not opened between the restart and its DROP.
CREATE TABLE tu LIKE t;
INSERT INTO tu VALUES (1, '(1,1)');

--source include/restart_mysqld.inc

--echo # DROP opens the table from the data dictionary without its index context.
DROP TABLE tu;

--echo # The same rows after the restart. Expected: 1, 3, 2
SELECT id FROM t ORDER BY cube_distance(c, '(0,0)') LIMIT 3;
--echo # DML still reaches the index. Expected: 1, 7, 3
INSERT INTO t VALUES (7, '(-0.1,0)');
SELECT id FROM t ORDER BY cube_distance(c, '(0,0)') LIMIT 3;

--echo #
--echo # Crash with a transaction open. Recovery opens the table to resurrect the
--echo # transaction, then rolls it back through the index: the rolled-back
--echo # insert is removed and the rolled-back delete and move are unmarked.
--echo #

INSERT INTO t VALUES (9, '(0,0.3)');
--connect (con1, localhost, root,,)
BEGIN;
INSERT INTO t VALUES (8, '(0.05,0)');
UPDATE t SET c = '(70,70)' WHERE id = 1;
DELETE FROM t WHERE id = 3;
--connection default
--source include/kill_and_restart_mysqld.inc
--disconnect con1

--echo # Wait for the background rollback of the recovered transaction
let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.innodb_trx;
--source include/wait_condition.inc

--echo # Expected: 1 (0), 7 (0.1), 9 (0.3), 3 (1.414214)
SELECT id, ROUND(cube_distance(c, '(0,0)'), 6) AS d
FROM t ORDER BY cube_distance(c, '(0,0)') LIMIT 4;
--echo # No entry is left behind for the rolled-back rows.
DELETE FROM t WHERE id IN (1, 3);
--echo # Expected: 7 (0.1), 9 (0.3), 2 (5)
SELECT id, ROUND(cube_distance(c, '(0,0)'), 6) AS d
FROM t ORDER BY cube_distance(c, '(0,0)') LIMIT 3;

DROP TABLE t;

UNINSTALL EXTENSION vsql_cube;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
