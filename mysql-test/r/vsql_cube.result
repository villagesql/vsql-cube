#
# Binary deserialization bounds
#
CREATE TABLE t_bounds (c `cube`(3) NOT NULL);
INSERT INTO t_bounds VALUES ('(1, 2, 3),(4, 5, 6)');
SELECT cube_dim(c) FROM t_bounds;
cube_dim(c)
3
SELECT cube_ll_coord(c, 1), cube_ll_coord(c, 2), cube_ll_coord(c, 3) FROM t_bounds;
cube_ll_coord(c, 1)	cube_ll_coord(c, 2)	cube_ll_coord(c, 3)
1	2	3
SELECT cube_ur_coord(c, 1), cube_ur_coord(c, 2), cube_ur_coord(c, 3) FROM t_bounds;
cube_ur_coord(c, 1)	cube_ur_coord(c, 2)	cube_ur_coord(c, 3)
4	5	6
SELECT cube_coord(c, 1), cube_coord(c, 4) FROM t_bounds;
cube_coord(c, 1)	cube_coord(c, 4)
1	4
SELECT cube_is_point(c) FROM t_bounds;
cube_is_point(c)
0
SELECT cube_to_string(cube_union(c, c)) FROM t_bounds;
cube_to_string(cube_union(c, c))
(1, 2, 3),(4, 5, 6)
SELECT cube_to_string(cube_inter(c, c)) FROM t_bounds;
cube_to_string(cube_inter(c, c))
(1, 2, 3),(4, 5, 6)
SELECT cube_distance(c, c) FROM t_bounds;
cube_distance(c, c)
0
DROP TABLE t_bounds;
CREATE TABLE t_agg_bounds (c `cube`(3) NOT NULL);
INSERT INTO t_agg_bounds VALUES ('(1, 2, 3)');
INSERT INTO t_agg_bounds VALUES ('(4, 5, 6)');
SELECT cube_to_string(cube_agg(c)) FROM t_agg_bounds;
cube_to_string(cube_agg(c))
(1, 2, 3),(4, 5, 6)
DROP TABLE t_agg_bounds;
#
# cube_hash normalizes -0.0 to +0.0 before hashing. cube_compare uses
# IEEE 754 < / > which treats -0.0 == +0.0, so without normalization the
# binary fallback hash assigns them different buckets while compare says
# they are equal — producing wrong GROUP BY / COUNT(DISTINCT) results.
# Note: this test asserts the correct result but cannot guarantee the
# optimizer routes through the hash path vs sort-based dedup. Hash
# correctness is verified by inspection of cube_hash in src/vsql_cube.cc.
#
CREATE TABLE t_neg_zero (`c` `cube`(1) NOT NULL);
INSERT INTO t_neg_zero VALUES ('(0)'), ('(-0.0)');
SELECT COUNT(DISTINCT `c`) AS distinct_count FROM t_neg_zero;
distinct_count
1
DROP TABLE t_neg_zero;
#
# Dimensionality is part of a cube's identity. cube_hash keys on ndim,
# so cube_compare must treat cubes whose zero-extended coordinates match
# but whose ndim differ (e.g. (1,2) vs (1,2,0)) as unequal — otherwise
# compare==0 while hash differs, corrupting GROUP BY / COUNT(DISTINCT).
#
CREATE TABLE t_ndim (`c` `cube`(3) NOT NULL);
INSERT INTO t_ndim VALUES ('(1,2)'), ('(1,2,0)'), ('(1,2)');
SELECT COUNT(*) AS rows_total, COUNT(DISTINCT `c`) AS distinct_count FROM t_ndim;
rows_total	distinct_count
3	2
SELECT cube_to_string(`c`) AS cube_val, COUNT(*) AS n
FROM t_ndim GROUP BY `c` ORDER BY `c`;
cube_val	n
(1, 2)	2
(1, 2, 0)	1
DROP TABLE t_ndim;
#
# cube_agg_result/cube_scalar_agg_result (the aggregate result functions)
# and the params-conversion helpers cube_int_to_params/CubeParams::to_strings
# are exception-guarded rather than left to crash the whole server on an
# internal allocation failure. This is a regression check that ordinary
# aggregation through that guarded path still returns the correct value.
#
CREATE TABLE t_agg_narrow (c `cube`(3) NOT NULL);
INSERT INTO t_agg_narrow VALUES ('(1, 2, 3)');
INSERT INTO t_agg_narrow VALUES ('(4, 5, 6)');
SELECT cube_to_string(cube_agg(c)) FROM t_agg_narrow;
cube_to_string(cube_agg(c))
(1, 2, 3),(4, 5, 6)
DROP TABLE t_agg_narrow;
CREATE TABLE t_scalar_agg_guard (x DOUBLE NOT NULL);
INSERT INTO t_scalar_agg_guard VALUES (1.0), (5.0);
SELECT cube_scalar_agg(x) FROM t_scalar_agg_guard;
cube_scalar_agg(x)
(1),(5)
DROP TABLE t_scalar_agg_guard;
#
# Non-finite coordinates
#
CREATE TABLE _tinf (id INT PRIMARY KEY, c `cube`(1) NOT NULL);
INSERT INTO _tinf VALUES (0, '(inf)');
ERROR HY000: Incorrect cube value: '(inf)' for column 'c' at row 1
INSERT INTO _tinf VALUES (0, '(nan)');
ERROR HY000: Incorrect cube value: '(nan)' for column 'c' at row 1
INSERT INTO _tinf VALUES (1, '(1.7e308)'), (2, '(1e308)');
SELECT cube_enlarge(c, 1.7e308, 1) FROM _tinf WHERE id = 1;
ERROR HY000: VDF error in function 'cube_enlarge': cube: coordinate 1 of the result is not finite
SELECT cube_enlarge(c, -1e308, 1) FROM _tinf WHERE id = 1;
ERROR HY000: VDF error in function 'cube_enlarge': cube: coordinate 1 of the result is not finite
SELECT cube_to_string(cube_enlarge(c, 7e307, 1)) FROM _tinf WHERE id = 2;
cube_to_string(cube_enlarge(c, 7e307, 1))
(3e+307),(1.7e+308)
UPDATE _tinf SET c = cube_enlarge(c, 1.7e308, 1) WHERE id = 1;
ERROR HY000: VDF error in function 'cube_enlarge': cube: coordinate 1 of the result is not finite
CREATE TABLE _tinf2 AS SELECT cube_enlarge(c, 1.7e308, 1) AS c FROM _tinf
WHERE id = 1;
ERROR HY000: VDF error in function 'cube_enlarge': cube: coordinate 1 of the result is not finite
SELECT id, cube_to_string(c) FROM _tinf ORDER BY id;
id	cube_to_string(c)
1	(1.7e+308)
2	(1e+308)
DROP TABLE _tinf;
