# Aggregates
#
CREATE TABLE t_cube (c `cube`(32) NOT NULL);
INSERT INTO t_cube VALUES ('(1),(3)');
INSERT INTO t_cube VALUES ('(2),(5)');
INSERT INTO t_cube VALUES ('(0, 0),(4, 6)');
SELECT cube_agg(c) FROM t_cube;
cube_agg(c)
(0, 0),(5, 6)
SELECT cube_agg(c) FROM t_cube WHERE 1 = 0;
cube_agg(c)
NULL
DROP TABLE t_cube;
CREATE TABLE t_cube_nm (c `cube`(3) NOT NULL);
INSERT INTO t_cube_nm VALUES ('(10,20,30)');
INSERT INTO t_cube_nm VALUES ('(15,18,35)');
SELECT cube_agg(c) FROM t_cube_nm;
cube_agg(c)
