CREATE TABLE _t100w (c `cube`(100) NOT NULL);
INSERT INTO _t100w VALUES ('(1,2)');
SELECT cube_add_dim(cube_add_dim(c, 3.0, 4.0), 5.0, 6.0) FROM _t100w;
cube_add_dim(cube_add_dim(c, 3.0, 4.0), 5.0, 6.0)
(1, 2, 3, 5),(1, 2, 4, 6)
DROP TABLE _t100w;
SET @v = '1,2', @p = '1,2';
PREPARE s FROM 'SELECT cube_dim(cube_point_nd(@v)), cube_dim(cube_box_nd(@v, @v)),
  cube_dim(cube_add_dim(cube_point(1.0), @p)),
  cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), @v))';
EXECUTE s;
cube_dim(cube_point_nd(@v))	cube_dim(cube_box_nd(@v, @v))	cube_dim(cube_add_dim(cube_point(1.0), @p))	cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), @v))
2	2	2	2
SET @v = '1,2,3', @p = '1,2,3,4';
EXECUTE s;
cube_dim(cube_point_nd(@v))	cube_dim(cube_box_nd(@v, @v))	cube_dim(cube_add_dim(cube_point(1.0), @p))	cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), @v))
3	3	3	3
PREPARE s FROM 'SELECT cube_dim(cube_point_nd(?))';
SET @v = '1,2';
EXECUTE s USING @v;
cube_dim(cube_point_nd(?))
2
SET @v = '1,2,3';
EXECUTE s USING @v;
cube_dim(cube_point_nd(?))
3
DEALLOCATE PREPARE s;
CREATE PROCEDURE p_bind(IN v VARCHAR(50), IN p VARCHAR(50))
BEGIN
SELECT cube_dim(cube_point_nd(v)), cube_dim(cube_box_nd(v, v)),
cube_dim(cube_add_dim(cube_point(1.0), p)),
cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), v));
END//
CALL p_bind('1,2', '1,2');
cube_dim(cube_point_nd(v))	cube_dim(cube_box_nd(v, v))	cube_dim(cube_add_dim(cube_point(1.0), p))	cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), v))
2	2	2	2
CALL p_bind('1,2,3', '1,2,3,4');
cube_dim(cube_point_nd(v))	cube_dim(cube_box_nd(v, v))	cube_dim(cube_add_dim(cube_point(1.0), p))	cube_dim(cube_subset(cube_point_nd(1.0, 2.0, 3.0), v))
3	3	3	3
DROP PROCEDURE p_bind;
